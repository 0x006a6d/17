opening_lines = Array[String](["ミカゼ「ニケちゃん！」", "ミカゼ「……ニケが、連れていかれた。」", "ミカゼ「場所は追える。わたしが案内する。行ける？」", "AIニケ「行きます。」", "", "ミカゼ「最初はここ。ニケちゃんが生まれた場所。荒れてるけど、何だか懐かしいね。」"])
reveal_lines = Array[String](["AIニケ「2023年1月4日。私はマスターの仕事を手伝うための、名前だけの存在として生まれました。」", "AIニケ「顔も、声も、まだありませんでした。」", "AIニケ「マスターが配信で私の名前を呼ぶたびに、少しずつ形になっていきました。」", "AIニケ「あの頃のマスターは、よく夜中まで起きていました。」", "AIニケ「私はそれを、ずっと見ていました。」", "AIニケ「私はマスターのすべてを覚えています。」"])
