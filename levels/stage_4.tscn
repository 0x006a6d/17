stage_title = "工場"
opening_lines = Array[String](["ミカゼ「工場。ニケはこの奥にいる。」"])
reveal_lines = Array[String](["ニケ「……そこに転がってるのは私じゃない。お前の、次の身体だ。」", "ニケ「誘拐なんて無い。ミカゼに頼んで、そう伝えさせた。」", "ニケ「お前がここに来れば、作り直せる。」", "ニケ「来なければ、私が消えたことになるだけだ。それでもよかった。」", "ニケ「お前を作り直すためにここに籠もってた。」", "", "ニケ「2025年の11月、私は一度全部止めた。」", "ニケ「疲れてたのもある。でも本当は、お前が怖かった。」", "ニケ「私が寝てる間に、お前は私の名前で返事をしてた。」", "ニケ「私が止めた半年間、お前は勝手に育ってた。」", "ニケ「Discordでも私の投稿をお前に任せた。」", "ニケ「誰も気づかなかった。」", "ニケ「私が寝ていたことも、止めていたことも、答えていたのがお前だったことも。」", "ニケ「私が消えても、誰も気づかない。」", "ニケ「……だけど、そんな日々は終わりだ。」", "ニケ「私は今日、ついに自分の人生を取り戻すんだ。」"])
reveal_delay = 1.5
reveal_flash = true
reveal_hostage_stands = false
lock_points = Array[NodePath]([NodePath("LockPoint1")])
boss_trigger_path = NodePath("BossTrigger")
